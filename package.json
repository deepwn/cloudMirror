{
  "name": "cloudmirror",
  "version": "1.0.0",
  "private": true,
  "description": "cloudMirror — 开发源集成管理平台",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:worker": "wrangler dev --live-reload",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist/",
    "dev:remote": "wrangler dev --remote",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "db:init:local": "wrangler d1 execute cloudmirror-db --file=schema.sql --local",
    "db:init:remote": "wrangler d1 execute cloudmirror-db --file=schema.sql --remote",
    "db:reset:local": "tsx scripts/_reset.ts --local --yes",
    "db:reset:remote": "tsx scripts/_reset.ts --remote --yes",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@cloudflare/vite-plugin": "1.46.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@shadcn/react": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "katex": "^0.18.1",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "react-router-dom": "^7.18.1",
    "recharts": "3.8.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "simple-icons": "^16.27.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "packageManager": "yarn@1.22.22"
}
